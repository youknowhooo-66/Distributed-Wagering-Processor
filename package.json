{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor — Jungle Gaming Technical Challenge",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.scripts.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "test": "ENABLE_BACKGROUND_POLL=false bun test src --timeout 10000",
    "test:unit": "ENABLE_BACKGROUND_POLL=false bun test src/test/unit --timeout 10000",
    "test:int": "ENABLE_BACKGROUND_POLL=false bun test src/test/integration --timeout 60000",
    "test:e2e": "ENABLE_BACKGROUND_POLL=false bun test src/test/concurrency --timeout 120000",
    "test:load": "ENABLE_BACKGROUND_POLL=false bun test src/test/load --timeout 300000",
    "migration:create": "bun run mikro-orm migration:create",
    "migration:up": "bun run src/shared/infrastructure/database/run-migrations.ts",
    "migration:down": "bun run src/shared/infrastructure/database/run-migrations-down.ts",
    "migration:list": "bun run mikro-orm migration:list",
    "dlq:redrive": "bun run scripts/dlq-redrive.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.600.0",
    "@mikro-orm/cli": "^6.0.0",
    "@mikro-orm/core": "^6.0.0",
    "@mikro-orm/migrations": "^6.0.0",
    "@mikro-orm/nestjs": "^6.0.0",
    "@mikro-orm/postgresql": "^6.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "decimal.js": "^10.4.0",
    "nestjs-pino": "^4.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.4.2",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^10.0.0",
    "typescript": "^5.7.0"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/shared/infrastructure/database/mikro-orm.config.ts"
    ]
  }
}

# Local development defaults (Bun loads .env automatically). Copy to .env and adjust.
# Values below match docker-compose.yml for PostgreSQL and LocalStack on the host.

# ── PostgreSQL ──
DATABASE_URL=postgresql://jungle:jungle_secret@localhost:5433/wagering
# Connections per instance; keep (instances x DB_POOL_MAX) below max_connections
DB_POOL_MAX=10
# Max wait for a wallet row lock; a timeout is retried and, when exhausted, answers 503
DB_LOCK_TIMEOUT_MS=5000ms

# ── SQS (LocalStack) ──
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo
# Inbox namespace: one per logical consumer (replicas of the same consumer share it)
CONSUMER_NAME=wager-transactions-consumer

# ── Application ──
PORT=3000
INSTANCE_ID=local
# Consumer, outbox publisher and workers. Test scripts force false.
ENABLE_BACKGROUND_POLL=true
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Retention (outbox published / inbox processed) ──
OUTBOX_RETENTION_DAYS=7
# Minimum 15: must outlive the SQS redelivery window (14 days)
INBOX_RETENTION_DAYS=30
